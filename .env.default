# Settings for the conky widgets. Copy this file to .env and fill it in:
#   cp .env.default .env
# .env is read by start.sh, the scripts in scripts/ and lua/theme.lua (for the
# Lua widgets). Plain KEY="value" lines only: $HOME is the only variable
# allowed, and no command substitution. Re-run start.sh after editing it.

# Conky executable (an AppImage path, or empty to use `conky` from PATH)
CONKY_BIN=""

# Weather: "auto" (located from your IP), a city ("Paris"), a city and country
# ("Paris, FR") or coordinates ("48.85, 2.35, Home"). Empty = auto.
WEATHER_LOCATION=""
# "metric" (°C, km/h) or "imperial" (°F, mph). Empty = metric.
WEATHER_UNITS=""

# Services: an Uptime Kuma status page. Base URL (no trailing slash), the
# status page's slug, and the monitors to show, by name, space-separated.
# Empty URL = the widget shows "no recent data".
SERVICES_URL=""
SERVICES_PAGE=""
SERVICES_NAMES=""

# VPS: Tailscale host names to ping, space-separated (up to ~5 fit in the
# round window).
VPS_HOSTS=""

# System: disks shown as gauges, space-separated name:mountpoint pairs (no
# spaces inside). The first one is drawn in the upload colour. Empty = root only.
SYSTEM_DISKS=""
